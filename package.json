{
  "name": "veloxtab",
  "version": "1.0.0",
  "description": "⚡ Ultra-fast, minimal multi-tab universal media player with PotPlayer dark frameless aesthetic & file takeover mode.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node tests/test_verify.js",
    "build:exe": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.zaxmil.veloxtab",
    "productName": "VeloxTab",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VeloxTab"
    }
  },
  "keywords": [
    "media-player",
    "video-player",
    "audio-player",
    "image-viewer",
    "multi-tab",
    "potplayer",
    "vlc",
    "electron"
  ],
  "author": "ZAX Mil <https://github.com/ZaxMil>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  }
}
